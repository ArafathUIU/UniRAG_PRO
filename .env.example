# Chat LLM API keys — Google Gemini is used by default if GEMINI_API_KEY is set.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq fallback key
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Password to enter the admin site (/manage/) and use the /admin/documents/ API.
ADMIN_PASSWORD=change-this-admin-password

REDIS_URL=redis://localhost:6379/0

PDF_SOURCE_DIR=./knowledge_base/pdfs
WEB_SOURCES_FILE=./knowledge_base/web_sources.txt
CHROMA_PERSIST_DIR=./chroma_store
